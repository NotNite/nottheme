---
import { ThemeLoader, ThemeSelect, ThemeStyling } from "nottheme";
// Make a file with your theme settings
import settings from "./theme";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="generator" content={Astro.generator} />
    <title>nottheme SSG demo</title>

    <!-- Include this at the bottom of the head (loads the CSS) -->
    <ThemeStyling settings={settings} />
  </head>

  <body>
    <!-- Include this at the top of the body (for applying the theme) -->
    <ThemeLoader settings={settings} />

    <main>
      <slot />
      <!-- Put this somewhere so users can configure themes -->
      <ThemeSelect settings={settings} />
    </main>
  </body>
</html>

<!-- Use the variables you defined in your settings -->
<style is:global>
  body {
    background-color: var(--bg);
    color: var(--fg);
    font-family: var(--font);
  }
</style>
