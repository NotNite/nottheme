---
import type { Settings } from "./types";

type SlimSettings = {
  // options
  o: Record<
    string,
    {
      // choices
      c: string[];

      // default
      d: string | (string | [string, string])[];
    }
  >;

  // root
  r?: string;
};

declare global {
  interface Window {
    __nottheme_settings: SlimSettings;
    __nottheme_getRoot: () => HTMLElement | null;
    __nottheme_computeDefault: (option: SlimSettings["o"][string]) => string;
    __nottheme_get: (option: string) => string;
    __nottheme_set: (option: string, choice: string, write?: boolean) => void;
    __nottheme_onChange?: (option: string, choice: string) => void;
  }
}

interface Props {
  settings: Settings;
}

// "Slim" down the settings so it takes up less characters
const { settings } = Astro.props;
const slimSettings: SlimSettings = { o: {}, r: settings.root };
for (const [key, value] of Object.entries(settings.options)) {
  slimSettings.o[key] = {
    c: value.choices,
    d:
      typeof value.default === "string"
        ? value.default
        : value.default.map((d) => {
            if (typeof d === "string") {
              return d;
            } else {
              return [d.query, d.choice];
            }
          })
  };
}

// https://docs.astro.build/en/guides/client-side-scripts/#pass-frontmatter-variables-to-scripts
const settingsJson = JSON.stringify(slimSettings);
---

<nottheme data-settings={settingsJson}></nottheme>
<script>
  const settings: typeof window.__nottheme_settings = JSON.parse(
    document.querySelector<HTMLElement>("nottheme")!.dataset.settings!
  );

  window.__nottheme_getRoot = () =>
    document.querySelector<HTMLElement>(settings.r ?? "body");

  window.__nottheme_computeDefault = (option) => {
    if (typeof option.d === "string") {
      return option.d;
    } else {
      for (const defaultEntry of option.d) {
        if (typeof defaultEntry === "string") {
          return defaultEntry;
        } else {
          const [query, choice] = defaultEntry;
          if (window.matchMedia(query).matches) {
            return choice;
          }
        }
      }

      return option.c[0];
    }
  };

  const localStoragePrefix = "nottheme-";
  const classPrefix = "nottheme__";
  const blankPrefix = "nottheme-choice-blank";
  const selectClass = "nottheme-select";
  const jsClass = "nottheme-js";

  window.__nottheme_get = (option) => {
    const localStorageKey = localStoragePrefix + option;
    const value = window.localStorage.getItem(localStorageKey);

    // `includes` check in case the option was deleted
    if (value && settings.o[option].c.includes(value)) return value;

    return window.__nottheme_computeDefault(settings.o[option]);
  };

  window.__nottheme_set = (option, choice, write) => {
    const localStorageKey = localStoragePrefix + option;
    const classKey = classPrefix + option;

    const root = window.__nottheme_getRoot();
    if (root != null) {
      const classList = root.classList;
      for (const className of classList) {
        if (className.startsWith(classKey + "__")) {
          classList.remove(className);
        }
      }
      classList.add(classKey + "__" + choice);
    }

    if (write !== false) {
      window.localStorage.setItem(localStorageKey, choice);
    }

    if (window.__nottheme_onChange) window.__nottheme_onChange(option, choice);
  };

  function init() {
    const root = window.__nottheme_getRoot();
    if (root != null && !root.classList.contains(jsClass)) {
      root.classList.add(jsClass);
    }

    for (const option of Object.keys(settings.o)) {
      const choice = window.__nottheme_get(option);
      window.__nottheme_set(option, choice, false);
    }
  }

  function register() {
    const selects = document.querySelectorAll<HTMLSelectElement>(
      `.${selectClass} select`
    );

    for (const select of selects) {
      select.addEventListener("change", () => {
        const element = select.options[select.selectedIndex];
        const id = element.id;
        const [_, option, choice] = id.split("__");
        window.__nottheme_set(option, choice);
      });

      for (const element of select.options) {
        if (element.id.startsWith(blankPrefix)) {
          // Blank option is only there for noscript
          select.removeChild(element);
        } else {
          const [_, option] = element.id.split("__");
          const choice = element.value;

          if (window.__nottheme_get(option) === choice) {
            element.selected = true;
          }
        }
      }
    }
  }

  init();
  document.addEventListener("DOMContentLoaded", register);

  document.addEventListener("astro:after-swap", () => {
    // Astro remakes the DOM on navigation
    init();
    register();
  });
</script>
